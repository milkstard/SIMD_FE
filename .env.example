# Copy to .env.local and fill in. Read only via src/app/config.ts.
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_API_SCOPE=api://<api-client-id>/access_as_user
VITE_API_BASE_URL=/api/v1
VITE_HUB_URL=/hubs/incidents
# Dev-server proxy target (used by vite.config.ts only)
VITE_API_PROXY_TARGET=http://localhost:5252
